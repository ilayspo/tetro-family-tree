DATABASE_URL=postgresql://...          # dedicated Neon pooled connection, server only
NEON_AUTH_BASE_URL=https://...     # Neon Auth URL
NEON_AUTH_COOKIE_SECRET=             # at least 32 random characters, server only
# The same server-only secret signs the family-view cookie. The family code itself
# is stored only as a scrypt hash in family_settings.
AWS_ENDPOINT_URL_S3=https://...   # Neon branch storage endpoint, server only
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEON_STORAGE_BUCKET=tetro-photos
AWS_REGION=eu-central-1
ADMIN_NOTIFICATION_EMAIL=ilayspo@gmail.com
RESEND_API_KEY=                     # server only; required for invitations and change notifications
EMAIL_FROM="Tetro Family Tree <family@example.com>"
